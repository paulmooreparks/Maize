; **********************************************************************************
; maize-313 AC-28: D-27's relatch, verified by the mechanism rather than by a payload.
;
; The `latched` arm of the park hook is the state where host stdin is readable and IRQ 33
; has ALREADY been raised for that readable state. In that arm the hook raises nothing and
; publishes no acknowledgement, so neither watcher is armed, and the latch that suppressed
; the raise has no event left that clears it: the data port is not being read, and a
; readiness answer of 0 cannot happen while the source is readable. Without a bounded park
; the core would sit there forever.
;
; A FILE-REDIRECTED stdin reaches that arm by ordinary behaviour rather than by a
; contrivance, which is why this fixture runs with stdin redirected from a regular file.
; The readiness probe cannot answer 0 for a regular file on either platform: the Windows
; disk branch returns 1 or -1, and POSIX poll always reports a regular file readable with
; FIONREAD splitting bytes-remaining from EOF. So the FIRST park raises (the latch is
; clear) and EVERY LATER park is the `latched` arm by construction.
;
; This guest never reads the data port, so nothing ever clears the latch and nothing about
; host input changes for the whole run. Each further IRQ 33 it sees is therefore
; attributable to the relatch and to nothing else. The handler counts raises and IRETs;
; the main loop re-issues HALT, which is what a guest must do now that a halted core may
; resume with no interrupt delivered.
;
; Expected output: "relatch: PASS" after the third raise, which takes about two relatch
; intervals. On a build whose `latched` arm takes the indefinite park instead of the
; bounded one, the second raise never arrives and the run hangs.
;
; Vector 33 is the console IRQ, so entry[33] lives at $1000 + 33*8 = $1108.
; **********************************************************************************

$0000`0000:
    ; ---- install the console-IRQ handler at entry[33] ($1108) ----
    CLR R0
    CP console_handler R0.H0
    CLR R1
    CP $1108 R1
    ST R0 @R1              ; entry[33] = console_handler

    ; ---- zero the raise counter ----
    CLR R0
    CLR R1
    CP raise_count R1.H0
    ST R0 @R1

park_loop:
    SETINT                 ; enable interrupts (a delivery masks them again)
    HALT                   ; park; the run loop waits at about 0 MIPS

    ; A halted core may resume with a delivered interrupt OR with none delivered, so the
    ; loop re-tests its own condition rather than assuming IRET is the only way here.
    CLR R1
    CP raise_count R1.H0
    CLR R2
    LD @R1 R2
    CMP $03 R2             ; three raises: the first, plus two the relatch caused
    JGE done
    JMP park_loop

done:
    CLRINT
    CLR R0
    CLR R1
    CLR R2
    CP $01 R0
    CP pass_string R1.H0
    CP $0E R2              ; 14 bytes
    SYS $01
    HALT

; **********************************************************************************
; Console interrupt handler. On entry SP points at aux (the four-word frame is, from SP
; upward: aux, cause, RF, PC). Discard the two trap-only words, count the raise, and
; return through IRET. It deliberately does NOT read the console data port: a data-port
; read clears the rising-edge latch, which would take the run out of the `latched` arm
; and stop testing the relatch.
console_handler:
    ADD $10 SP             ; discard aux + cause (2 words); SP now at the saved RF
    PUSH R8
    PUSH R9

    CLR R8
    CP raise_count R8.H0
    LD @R8 R9
    INC R9
    ST R9 @R8              ; ++raises seen

    POP R9
    POP R8
    IRET

; **********************************************************************************
raise_count:
    DATA $00 $00 $00 $00 $00 $00 $00 $00   ; 8-byte raise counter

pass_string:
    STRING "relatch: PASS\n\0"
